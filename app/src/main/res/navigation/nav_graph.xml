<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.weatherforecasts.homescreen.view.HomeFragment"
        android:label="Home" >

        <argument
            android:name="latitude"
            app:argType="string"
            app:nullable="false"

             />
        <argument
            android:name="longitude"
            app:argType="string"
            app:nullable="false"

            />
        <argument
            android:name="homeLocation"
            app:argType="string"
            android:defaultValue="Home"
            />


        <action
            android:id="@+id/action_homeFragment_self"
            app:destination="@id/homeFragment" />


    </fragment>
    <fragment
        android:id="@+id/favouritFragment"
        android:name="com.example.weatherforecasts.favourit.view.FavoriteFragment"
        android:label="Favourite"
        tools:layout="@layout/fragment_favourit" >
        <action
            android:id="@+id/action_favouritFragment_to_locationPickerDialog"
            app:destination="@id/locationPickerDialog" />
        <argument
            android:name="latitude"
            app:argType="string"
             />
        <argument
            android:name="longitude"
            app:argType="string"
            />


        <action
            android:id="@+id/action_favouritFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

    </fragment>
    <fragment
        android:id="@+id/alertFragment"
        android:name="com.example.weatherforecasts.alertscreen.view.AlertFragment"
        android:label="Alert" >
        <action
            android:id="@+id/action_alertFragment_to_alertDialogFragment"
            app:destination="@id/alertDialogFragment" />
        <action
            android:id="@+id/action_alertFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.example.weatherforecasts.settingscreen.view.SettingFragment"
        android:label="Setting"
        tools:layout="@layout/fragment_setting" >

        <action
            android:id="@+id/action_settingFragment_to_locationPickerDialog"
            app:destination="@id/locationPickerDialog" />
        <action
            android:id="@+id/action_settingFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

    </fragment>
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.weatherforecasts.SplashFragment"
        android:label="Splash" >
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <dialog
        android:id="@+id/locationPickerDialog"
        android:name="com.example.weatherforecasts.map.LocationPickerDialog"
        android:label="LocationPickerDialog" >

        <action
            android:id="@+id/action_locationPickerDialog_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_locationPickerDialog_to_favouritFragment"
            app:destination="@id/favouritFragment" />
    </dialog>
    <fragment
        android:id="@+id/alertDialogFragment"
        android:name="com.example.weatherforecasts.alertscreen.view.AlertDialogFragment"
        android:label="Alert_dialog"
        tools:layout="@layout/fragment_alert_dialog" >
        <action
            android:id="@+id/action_alertDialogFragment_to_alertFragment"
            app:destination="@id/alertFragment" />
        <argument
            android:name="latitude"
            app:argType="string"
          />
        <argument
            android:name="longitude"
            app:argType="string"
            />
        <action
            android:id="@+id/action_alertDialogFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_alertDialogFragment_to_homeFragment2"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_alertDialogFragment_to_homeFragment3"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_alertDialogFragment_to_homeFragment4"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_alertDialogFragment_to_homeFragment5"
            app:destination="@id/homeFragment" />
    </fragment>
</navigation>